{
  "_comment": "FLUX.1-dev fp8 + PuLID face-identity workflow. PuLID locks a face from a reference image into every generated scene, ensuring character consistency across all 5 commercial scenes. Node ids: 5=CheckpointLoaderSimple (FLUX fp8), 11=DualCLIPLoader, 6=positive, 7=negative, 10=EmptyLatentImage, 25=KSampler, 27=VAEDecode, 26=SaveImage. PuLID nodes: 50=PulidModelLoader, 51=PulidInsightFaceLoader, 52=PulidEvaClipLoader, 53=LoadImage (face reference), 54=ApplyPulid (modifies MODEL). KSampler uses node 54's MODEL output instead of node 5.",
  "5": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "flux1-dev-fp8.safetensors"
    }
  },
  "11": {
    "class_type": "DualCLIPLoader",
    "inputs": {
      "clip_name1": "clip_l.safetensors",
      "clip_name2": "t5xxl_fp8_e4m3fn.safetensors",
      "type": "flux"
    }
  },
  "50": {
    "class_type": "PulidModelLoader",
    "inputs": {
      "pulid_file": "pulid_flux_v0.9.1.safetensors"
    }
  },
  "51": {
    "class_type": "PulidInsightFaceLoader",
    "inputs": {
      "provider": "CUDA"
    }
  },
  "52": {
    "class_type": "PulidEvaClipLoader",
    "inputs": {}
  },
  "53": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "face_reference.png"
    }
  },
  "54": {
    "class_type": "ApplyPulid",
    "inputs": {
      "model": ["5", 0],
      "pulid": ["50", 0],
      "eva_clip": ["52", 0],
      "face_analysis": ["51", 0],
      "image": ["53", 0],
      "method": "fidelity",
      "weight": 0.9,
      "start_at": 0.0,
      "end_at": 1.0
    }
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "positive prompt",
      "clip": ["11", 0]
    }
  },
  "7": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "negative prompt",
      "clip": ["11", 0]
    }
  },
  "10": {
    "class_type": "EmptyLatentImage",
    "inputs": {
      "width": 1080,
      "height": 1920,
      "batch_size": 1
    }
  },
  "25": {
    "class_type": "KSampler",
    "inputs": {
      "seed": 0,
      "steps": 20,
      "cfg": 1.0,
      "sampler_name": "euler",
      "scheduler": "normal",
      "denoise": 1.0,
      "model": ["54", 0],
      "positive": ["6", 0],
      "negative": ["7", 0],
      "latent_image": ["10", 0]
    }
  },
  "27": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["25", 0],
      "vae": ["5", 2]
    }
  },
  "26": {
    "class_type": "SaveImage",
    "inputs": {
      "filename_prefix": "flux_pulid_out",
      "images": ["27", 0]
    }
  }
}